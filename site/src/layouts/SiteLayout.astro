---
import { siteData } from '../data';
import Breadcrumbs, { type Breadcrumb } from '../components/Breadcrumbs.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
// 見出しの書体を同梱する（設計書 §7.2）。閲覧環境のフォント有無で字幅が変わると、
// ヘッダのナビや年表の軸がレイアウト前提からずれる。使うのは見出しの700のみ。
// unicode-range で分割された 700.css を使い、閲覧時は表示に必要なサブセットだけ転送させる。
import '@fontsource/shippori-mincho-b1/700.css';
import '../styles/global.css';
import '../styles/tokens.css';
import '../styles/archive-design.css';

interface Props {
	title?: string;
	description?: string;
	currentPath?: string;
	breadcrumbs?: readonly Breadcrumb[];
}

const { title = siteData.title, description = '門田匡陽の音楽活動に関する作品、ライブ、人物、資料の記録をまとめています。', currentPath = Astro.url.pathname, breadcrumbs = [] } = Astro.props;
const pageTitle = title === siteData.title ? title : `${title} | ${siteData.title}`;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#F5F5F1" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<title>{pageTitle}</title>
	</head>
	<body>
		<div class="site-shell">
			<a class="skip-link" href="#main-content">本文へスキップ</a>
			<SiteHeader currentPath={currentPath} />
			<main id="main-content" class="site-main">
				<Breadcrumbs items={breadcrumbs} />
				<slot />
			</main>
			<SiteFooter />
		</div>
	</body>
</html>
