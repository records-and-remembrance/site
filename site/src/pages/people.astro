---
import SiteLayout from '../layouts/SiteLayout.astro';
import { siteTableRows } from '../data';
import { buildPeopleList } from '../lib/people';

const people = buildPeopleList(siteTableRows('person'));
---

<SiteLayout title="人物" currentPath="/people" breadcrumbs={[{ label: '人物' }]}>
	<section aria-labelledby="people-title">
		<p class="eyebrow">PEOPLE</p>
		<h1 id="people-title">人物</h1>
		<p>プロジェクトやライブの記録に登場する参加人物を一覧にしています。</p>
		{people.length === 0 ? (
			<p>人物データはありません。</p>
		) : (
			<ul class="people-grid">
				{people.map((person) => {
					return (
						<li class="person-card">
							{person.href ? <a href={person.href}>{person.name}</a> : <span>{person.name}</span>}
							{person.description && <p>{person.description}</p>}
						</li>
					);
				})}
			</ul>
		)}
	</section>
</SiteLayout>

<style>
	section[aria-labelledby='people-title'] > p {
		max-width: var(--reading-width);
	}

	.people-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: var(--space-3);
		margin: var(--space-5) 0 0;
		padding: 0;
		list-style: none;
	}

	.person-card {
		min-block-size: 9rem;
		padding: var(--space-4);
		border: 1px solid var(--rule);
		background: var(--surface);
	}

	.person-card > a,
	.person-card > span {
		font-size: 1.15rem;
		font-weight: 700;
	}

	.person-card p {
		margin-block: var(--space-3) 0;
		color: var(--ink-muted);
		font-size: 0.92rem;
	}
</style>
