---
import Artwork from '../../components/Artwork.astro';
import ConnectionLinks from '../../components/ConnectionLinks.astro';
import DateText from '../../components/DateText.astro';
import EntityLink from '../../components/EntityLink.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { siteTableRows } from '../../data';
import { buildDiscographyDetail, type DiscographyDetailSource, type DiscographyEdition, type DiscographyTrack } from '../../lib/discography-detail';
import { buildEntityHref } from '../../lib/site-foundation';

const detailSource: DiscographyDetailSource = {
	work: siteTableRows('work'),
	project: siteTableRows('project'),
	workProject: siteTableRows('workProject'),
	release: siteTableRows('release'),
	distributor: siteTableRows('distributor'),
	label: siteTableRows('label'),
	labelRelation: siteTableRows('labelRelation'),
	track: siteTableRows('track'),
	recording: siteTableRows('recording'),
	composition: siteTableRows('composition'),
	person: siteTableRows('person'),
	role: siteTableRows('role'),
	instrument: siteTableRows('instrument'),
	contribution: siteTableRows('contribution'),
};

export function getStaticPaths() {
	return siteTableRows('work')
		.filter((work) => Boolean(buildEntityHref('work', typeof work.slug === 'string' ? work.slug : undefined)))
		.map((work) => ({ params: { slug: work.slug as string } }));
}

const detail = buildDiscographyDetail(detailSource, Astro.params.slug);
if (!detail) throw new Error(`Discography work not found: ${Astro.params.slug ?? '(missing slug)'}`);

const artworkOrigins = (import.meta.env.PUBLIC_ARTWORK_ORIGINS ?? '').split(',').map((origin) => origin.trim()).filter(Boolean);
const precision = (value: string | null): 'year' | 'month' | 'day' | 'uncertain' | null =>
	value === 'year' || value === 'month' || value === 'day' || value === 'uncertain' ? value : null;

const releaseLabel = (release: DiscographyEdition): string => release.format ?? '形式未登録';
const trackVersion = (track: DiscographyTrack): string => [track.recording.versionName, track.recording.type].filter(Boolean).join(' · ') || '録音情報未登録';
const workTypeLabel = (type: string | null): string => ({ original: 'オリジナル作品', compilation: 'コンピレーション', best: 'ベスト作品', live: 'ライブ作品' })[type ?? ''] ?? '作品';
const representativeArtwork = detail.representativeRelease.artwork;
---

<SiteLayout title={detail.work.title} currentPath="/discography" breadcrumbs={[{ label: '作品', href: '/discography' }, { label: detail.work.title }]}>
	<article class="discography-detail">
		<header class="discography-detail__header" aria-labelledby="discography-detail-title">
			<div class="discography-detail__artwork" aria-label={`${detail.work.title}の代表ジャケット`}>
				{representativeArtwork.url ? (
					<Artwork url={representativeArtwork.url} width={representativeArtwork.width} height={representativeArtwork.height} alt={`${detail.work.title}の代表ジャケット`} allowedOrigins={artworkOrigins} loading="eager" />
				) : (
					<div class="discography-detail__artwork-placeholder" role="img" aria-label={`${detail.work.title}のジャケット画像は未登録`}>
						<span>ARCHIVE / WORK</span>
						<strong>{detail.work.title}</strong>
						<span>JACKET NOT ARCHIVED</span>
					</div>
				)}
			</div>
			<div class="discography-detail__intro">
				<p class="eyebrow">WORK / {workTypeLabel(detail.work.type).toUpperCase()}</p>
				<h1 id="discography-detail-title">{detail.work.title}</h1>
				<div class="discography-detail__meta">
					{detail.work.project && <EntityLink type="project" slug={detail.work.project.slug} label={detail.work.project.name} />}
					{detail.work.releasedDate && <span><DateText value={detail.work.releasedDate} precision={precision(detail.work.releasedDatePrecision)} /></span>}
					<span>{detail.releases.length > 0 ? `${detail.releases.length}版` : '版情報未登録'}</span>
				</div>
				{detail.work.description && <p class="discography-detail__description">{detail.work.description}</p>}
			</div>
		</header>

		<nav class="discography-detail__section-nav" aria-label="作品内の移動">
			<a href="#discography-tracks-title">収録曲</a>
			<a href="#discography-editions-title">版を比べる</a>
			<a href="#connections-title">つながり</a>
		</nav>

		<div class="discography-detail__body">
			<div>
		<section aria-labelledby="discography-tracks-title" class="discography-detail__section">
			<p class="eyebrow">TRACKLIST / 01</p>
			<h2 id="discography-tracks-title">代表版の収録曲</h2>
			{detail.representativeRelease.hasTracks ? (
				<ol class="track-list">
					{detail.representativeRelease.tracks.map((track) => (
						<li class="track-list__item">
							<span class="track-list__number" aria-label={`${track.trackNumber}曲目`}>{track.trackNumber}</span>
							<div class="track-list__main">
								<div class="track-list__title-row">
									<span>{track.href ? <a href={track.href}>{track.title}</a> : track.title}</span>
									<span class="track-list__leader" aria-hidden="true"></span>
									<span class="track-list__version">{trackVersion(track)}</span>
								</div>
							</div>
						</li>
					))}
				</ol>
			) : (
				<p class="empty-state">収録曲情報未登録</p>
			)}
		</section>

		<section aria-labelledby="discography-editions-title" class="discography-detail__section">
			<p class="eyebrow">EDITIONS / 02</p>
			<h2 id="discography-editions-title">同じ作品、異なる版。</h2>
			{detail.releases.length === 0 ? (
				<p class="empty-state">版情報はまだありません。</p>
			) : (
				<div class="edition-list">
					{detail.releases.map((release) => (
						<article class="edition-card" id={release.anchor ?? undefined}>
							<header class="edition-card__header">
								<div>
									<p class="eyebrow">EDITION</p>
									<h3>{releaseLabel(release)}</h3>
									{release.editionType && <p class="edition-card__type">{release.editionType === 'reissue' ? '再発' : '初版'}</p>}
								</div>
								<Artwork url={release.artwork.url} width={release.artwork.width} height={release.artwork.height} alt={`${detail.work.title} ${releaseLabel(release)}のジャケット`} allowedOrigins={artworkOrigins} />
							</header>

							<dl class="edition-card__metadata">
								<div><dt>発売日</dt><dd>{release.releaseDate ? <DateText value={release.releaseDate} precision={precision(release.releaseDatePrecision)} /> : '発売日不明'}</dd></div>
								{release.catalogNumber && <div><dt>カタログ番号</dt><dd>{release.catalogNumber}</dd></div>}
								{release.labels.length > 0 && <div><dt>レーベル</dt><dd>{release.labels.map((label) => <span>{label.name}</span>)}</dd></div>}
								{release.distributor && <div><dt>ディストリビューター</dt><dd>{release.distributor.name}</dd></div>}
								<div><dt>画像メタデータ</dt><dd>{release.artwork.width && release.artwork.height ? `${release.artwork.width} × ${release.artwork.height}px` : '未登録'}</dd></div>
							</dl>

							{release.reissueOf && (
								<p class="edition-card__relation"><a href={release.reissueOf.href}>再発元: {release.reissueOf.label}</a></p>
							)}
							{release.reissues.length > 0 && (
								<p class="edition-card__relation">再発: {release.reissues.map((reissue) => <a href={reissue.href}>{reissue.label}</a>)}</p>
							)}
							{release.description && <p>{release.description}</p>}

							{release.trackDiffs.length > 0 && (
								<section aria-labelledby={`edition-${release.editionKey}-diff-title`} class="edition-card__diff">
									<h4 id={`edition-${release.editionKey}-diff-title`}>初版との差分</h4>
									<ul>
										{release.trackDiffs.map((diff) => (
											<li>{diff.kind === 'added' ? '追加' : diff.kind === 'removed' ? '削除' : '変更'}: {diff.trackNumber}. {diff.href ? <a href={diff.href}>{diff.title}</a> : diff.title}</li>
										))}
									</ul>
								</section>
							)}

							<section aria-labelledby={`edition-${release.editionKey}-contributions-title`} class="edition-card__contributions">
								<h4 id={`edition-${release.editionKey}-contributions-title`}>参加者</h4>
								{release.contributions.length > 0 ? (
									<ul>
										{release.contributions.map((contribution) => (
											<li>
												{contribution.person.href ? <a href={contribution.person.href}>{contribution.person.name}</a> : contribution.person.name}
												<span> — {contribution.role}</span>
												{contribution.instrument && <span>（{contribution.instrument}）</span>}
											</li>
										))}
									</ul>
								) : (
									<p class="empty-state">参加者情報未登録</p>
								)}
							</section>
						</article>
					))}
				</div>
			)}
		</section>
			</div>
			<aside class="discography-detail__aside">
				<p class="eyebrow">ARCHIVE NOTE</p>
				<h2>作品の記録</h2>
				<p>この作品に紐づく収録曲、版、参加者をまとめています。曲名から楽曲の収録・演奏記録へ移動できます。</p>
				{detail.representativeRelease.releaseDate && <dl class="discography-detail__summary"><div><dt>代表版</dt><dd>{releaseLabel(detail.representativeRelease)}</dd></div><div><dt>発売</dt><dd><DateText value={detail.representativeRelease.releaseDate} precision={precision(detail.representativeRelease.releaseDatePrecision)} /></dd></div><div><dt>収録曲</dt><dd>{detail.representativeRelease.tracks.length}曲</dd></div></dl>}
			</aside>
		</div>

		<ConnectionLinks links={detail.relatedLinks} />
	</article>
</SiteLayout>

<style>
	.discography-detail__header {
		display: grid;
		grid-template-columns: minmax(14rem, 25rem) minmax(0, 1fr);
		gap: clamp(var(--space-5), 7vw, var(--space-7));
		align-items: center;
		margin-block-end: var(--space-6);
		padding-block-end: var(--space-6);
		border-block-end: 3px solid var(--rule);
	}

	.discography-detail__artwork {
		aspect-ratio: 1;
		border-block-start: 5px solid var(--accent);
		background: var(--surface);
	}

	.discography-detail__artwork img,
	.discography-detail__artwork .artwork-fallback,
	.discography-detail__artwork-placeholder {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.discography-detail__artwork-placeholder {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: clamp(var(--space-4), 4vw, var(--space-6));
		border: 1px solid var(--rule);
		color: var(--ink);
	}

	.discography-detail__artwork-placeholder::before {
		position: absolute;
		inset-block: 20%;
		left: 50%;
		border-inline-start: 1px solid var(--rule);
		content: '';
		transform: rotate(28deg);
	}

	.discography-detail__artwork-placeholder span {
		position: relative;
		color: var(--ink-muted);
		font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
		font-size: 0.68rem;
		letter-spacing: 0.06em;
	}

	.discography-detail__artwork-placeholder strong {
		position: relative;
		max-width: 100%;
		font-family: 'Shippori Mincho B1', 'Hiragino Mincho ProN', serif;
		font-size: clamp(1.4rem, 3vw, 2.6rem);
		line-height: 1.2;
		overflow-wrap: anywhere;
	}

	.discography-detail__intro h1 {
		margin-block: var(--space-2) var(--space-4);
		font-size: clamp(2.25rem, 6vw, 5rem);
		line-height: 1.1;
	}

	.discography-detail__intro {
		min-width: 0;
	}

	.discography-detail__meta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-4);
		color: var(--ink-muted);
	}

	.discography-detail__description {
		max-width: 48rem;
		margin-block-start: var(--space-5);
		white-space: pre-wrap;
	}

	.discography-detail__section-nav {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
		margin-block-end: var(--space-7);
		border-block-end: 1px solid var(--rule);
	}

	.discography-detail__section-nav a {
		padding-block: var(--space-3);
		color: var(--ink);
		text-decoration: none;
	}

	.discography-detail__section-nav a:hover {
		color: var(--accent);
	}

	.discography-detail__body {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(14rem, 18rem);
		gap: clamp(var(--space-6), 8vw, var(--space-7));
		align-items: start;
	}

	.discography-detail__section {
		margin-block: 0 var(--space-7);
	}

	.track-list {
		max-width: 52rem;
		padding-inline-start: 0;
		list-style: none;
	}

	.track-list__item {
		display: grid;
		grid-template-columns: 3rem 1fr;
		gap: var(--space-3);
		padding-block: var(--space-3);
		border-block-end: 1px solid var(--rule);
		transition: background-color var(--motion-duration) var(--motion-ease);
	}

	.track-list__item:hover {
		background: color-mix(in srgb, var(--accent) 5%, transparent);
	}

	.track-list__number {
		color: var(--ink-muted);
		font-variant-numeric: tabular-nums;
	}

	.track-list__main {
		display: grid;
		gap: var(--space-1);
	}

	.track-list__title-row {
		display: grid;
		grid-template-columns: auto minmax(2rem, 1fr) auto;
		gap: var(--space-2);
		align-items: baseline;
	}

	.track-list__leader {
		min-width: 2rem;
		border-block-end: 1px dotted var(--rule);
	}

	.track-list__version,
	.edition-card__type,
	.edition-card__relation {
		color: var(--ink-muted);
		font-size: 0.9em;
	}

	.edition-list {
		display: grid;
		gap: var(--space-5);
	}

	.edition-card {
		padding: var(--space-5);
		border: 1px solid var(--rule);
		background: var(--surface);
		box-shadow: 8px 8px 0 color-mix(in srgb, var(--rule) 45%, transparent);
		scroll-margin-block-start: var(--space-5);
	}

	.discography-detail__aside {
		position: sticky;
		top: var(--space-4);
		padding: var(--space-4);
		border-block-start: 3px solid var(--accent);
		background: var(--surface);
	}

	.discography-detail__aside h2 {
		margin-block: var(--space-2) var(--space-3);
		font-size: 1.25rem;
	}

	.discography-detail__summary {
		display: grid;
		gap: var(--space-2);
		margin-block-start: var(--space-5);
	}

	.discography-detail__summary div {
		display: flex;
		justify-content: space-between;
		gap: var(--space-3);
		padding-block: var(--space-2);
		border-block-end: 1px solid var(--rule);
	}

	.discography-detail__summary dt { color: var(--ink-muted); }
	.discography-detail__summary dd { margin: 0; text-align: end; }

	.edition-card__header {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(8rem, 12rem);
		gap: var(--space-5);
		align-items: start;
	}

	.edition-card__header .artwork-fallback,
	.edition-card__header img {
		width: 100%;
		height: auto;
		aspect-ratio: 1;
		object-fit: contain;
	}

	.edition-card__metadata {
		display: grid;
		gap: var(--space-2);
		margin-block: var(--space-5);
	}

	.edition-card__metadata > div {
		display: grid;
		grid-template-columns: 10rem 1fr;
		gap: var(--space-3);
		padding-block-end: var(--space-2);
		border-block-end: 1px solid var(--rule);
	}

	.edition-card__metadata dt {
		color: var(--ink-muted);
	}

	.edition-card__metadata dd {
		margin: 0;
	}

	.edition-card__metadata dd span + span::before {
		content: '、';
	}

	.edition-card__relation {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}

	.edition-card__diff,
	.edition-card__contributions {
		margin-block-start: var(--space-5);
		padding-block-start: var(--space-4);
		border-block-start: 1px solid var(--rule);
	}

	.edition-card__diff h4,
	.edition-card__contributions h4 {
		margin-block-start: 0;
	}

	@media (max-width: 40rem) {
		.discography-detail__header,
		.discography-detail__body {
			grid-template-columns: 1fr;
		}

		.discography-detail__artwork {
			max-width: 22rem;
		}

		.discography-detail__aside {
			position: static;
		}

		.track-list__title-row {
			grid-template-columns: 1fr;
		}

		.track-list__leader {
			display: none;
		}

		.edition-card {
			padding: var(--space-4);
		}

		.edition-card__header {
			grid-template-columns: 1fr;
		}

		.edition-card__header .artwork-fallback,
		.edition-card__header img {
			max-width: 12rem;
		}

		.edition-card__metadata > div {
			grid-template-columns: 1fr;
			gap: var(--space-1);
		}
	}
</style>
