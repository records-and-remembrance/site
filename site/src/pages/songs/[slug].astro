---
import DateText from '../../components/DateText.astro';
import EntityLink from '../../components/EntityLink.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { siteTableRows } from '../../data';
import { buildSongDetail, type SongDetailSource, type SongRecording } from '../../lib/song-detail';
import { buildSongJourney, buildSongPerformanceHistory } from '../../lib/song-discovery';
import { buildEntityHref } from '../../lib/site-foundation';

const detailSource: SongDetailSource = {
	composition: siteTableRows('composition'),
	compositionCredit: siteTableRows('compositionCredit'),
	person: siteTableRows('person'),
	recording: siteTableRows('recording'),
	track: siteTableRows('track'),
	release: siteTableRows('release'),
	work: siteTableRows('work'),
	project: siteTableRows('project'),
	eventPerformance: siteTableRows('eventPerformance'),
	event: siteTableRows('event'),
	venue: siteTableRows('venue'),
};

export function getStaticPaths() {
	return siteTableRows('composition')
		.filter((composition) => Boolean(buildEntityHref('composition', typeof composition.slug === 'string' ? composition.slug : undefined)))
		.map((composition) => ({ params: { slug: composition.slug as string } }));
}

const detail = buildSongDetail(detailSource, Astro.params.slug);
if (!detail) throw new Error(`Song not found: ${Astro.params.slug ?? '(missing slug)'}`);

const creditLabel = (creditType: 'composer' | 'lyricist'): string => (creditType === 'composer' ? '作曲' : '作詞');
const recordingLabel = (recording: SongRecording): string => recording.versionName ?? '名称未登録';
const discoverySource = { eventPerformance: detailSource.eventPerformance, event: detailSource.event, track: detailSource.track, recording: detailSource.recording, release: detailSource.release, work: detailSource.work };
const journey = buildSongJourney(detail.composition.id, discoverySource);
const history = buildSongPerformanceHistory(detail.composition.id, discoverySource);
const heatMax = Math.max(1, ...history.years.map((year) => year.count));
---

<SiteLayout title={detail.composition.title} currentPath="/songs" breadcrumbs={[{ label: '楽曲', href: '/songs' }, { label: detail.composition.title }]}>
	<article class="song-detail">
		<header class="song-detail__header" aria-labelledby="song-detail-title">
			<p class="eyebrow">SONG</p>
			<h1 id="song-detail-title">{detail.composition.title}</h1>
			{detail.composition.description && <p class="song-detail__description">{detail.composition.description}</p>}
		</header>

		<section class="song-detail__section" aria-labelledby="song-credits-title">
			<h2 id="song-credits-title">クレジット</h2>
			<div class="song-detail__credit-groups">
				{(['composer', 'lyricist'] as const).map((creditType) => {
					const credits = detail.credits[creditType];
					return (
						<section aria-labelledby={`song-${creditType}-title`}>
							<h3 id={`song-${creditType}-title`}>{creditLabel(creditType)}</h3>
							{credits.length > 0 ? (
								<ol>
									{credits.map((credit) => (
										<li>
											<EntityLink type="person" slug={credit.slug} label={credit.name} />
										</li>
									))}
								</ol>
							) : (
								<p class="empty-state">登録なし</p>
							)}
						</section>
					);
				})}
			</div>
		</section>

		<section class="song-detail__section" aria-labelledby="song-recordings-title">
			<h2 id="song-recordings-title">録音</h2>
			{detail.recordings.length === 0 ? (
				<p class="empty-state">
					録音情報はありません。
					{detail.liveOnly && <span>ライブ演奏のみ。</span>}
				</p>
			) : (
				<div class="song-detail__recordings">
					{detail.recordings.map((recording) => (
						<article class="recording-card">
							<header>
								<h3>{recordingLabel(recording)}</h3>
								{recording.type && <p class="recording-card__type">{recording.type}</p>}
							</header>
							{recording.versionDescription && <p>{recording.versionDescription}</p>}
							<dl class="recording-card__metadata">
								<div>
									<dt>初出release年</dt>
									<dd>{recording.firstReleaseDate ? <DateText value={recording.firstReleaseDate} precision="year" /> : '不明'}</dd>
								</div>
								<div>
									<dt>収録版数</dt>
									<dd>{recording.placements.length}</dd>
								</div>
							</dl>
							<section aria-labelledby={`recording-${recording.id}-placements`}>
								<h4 id={`recording-${recording.id}-placements`}>収録作品・版</h4>
								{recording.placements.length > 0 ? (
									<ul class="placement-list">
										{recording.placements.map((placement) => (
											<li>
												{placement.href ? <a href={placement.href}>{placement.work.name}</a> : <span>{placement.work.name}</span>}
												<span class="placement-list__meta">
													{placement.format ?? '形式未登録'} · {placement.releaseDate ? <DateText value={placement.releaseDate} precision="day" /> : '発売日不明'} · {placement.trackNumber}曲目
												</span>
											</li>
										))}
									</ul>
								) : (
									<p class="empty-state">収録版情報はありません。</p>
								)}
							</section>
						</article>
					))}
				</div>
			)}
		</section>

			<section class="song-detail__section" aria-labelledby="song-performances-title">
			<h2 id="song-performances-title">ライブ演奏</h2>
			{detail.performances.length === 0 ? (
				<p class="empty-state">演奏記録はありません。</p>
			) : (
				<ul class="performance-list">
					{detail.performances.map((performance) => (
						<li class="performance-card">
							<div class="performance-card__title">
								<EntityLink type="event" slug={performance.event.slug} label={performance.event.name} />
								{performance.encore && <span>アンコール</span>}
							</div>
							<dl class="performance-card__metadata">
								<div>
									<dt>日付</dt>
									<dd>{performance.eventDate ? <DateText value={performance.eventDate} precision="day" /> : '日付不明'}</dd>
								</div>
								<div>
									<dt>名義</dt>
									<dd><EntityLink type="project" slug={performance.project.slug} label={performance.project.name} /></dd>
								</div>
								<div>
									<dt>会場</dt>
									<dd><EntityLink type="venue" slug={performance.venue.slug} label={performance.venue.name} /></dd>
								</div>
								<div>
									<dt>曲順</dt>
									<dd>{performance.orderIndex}</dd>
								</div>
							</dl>
							{performance.variationNote && <p>Variation: {performance.variationNote}</p>}
							{performance.notes && <p>{performance.notes}</p>}
						</li>
					))}
				</ul>
			)}
			</section>

			<section class="song-detail__section" aria-labelledby="song-discovery-title">
				<h2 id="song-discovery-title">収録・演奏の履歴</h2>
				{journey.length > 0 && (
					<div>
						<h3>収録履歴</h3>
						<ol class="song-journey">{journey.map((item, index) => <li><span class="song-journey__marker" aria-hidden="true"></span><span class="song-journey__content">{item.href ? <a href={item.href}>{item.label}</a> : <span>{item.label}</span>}<small>{item.date}{index === 0 ? ' · 初出' : ''}</small></span></li>)}</ol>
					</div>
				)}
				{history.count > 0 && (
					<div>
						<h3>演奏史</h3>
						<p>初演: <DateText value={history.firstDate} precision="day" /> · 最終演奏: <DateText value={history.lastDate} precision="day" /> · {history.count}回</p>
						{history.encoreRate !== undefined && <p>アンコール率: {Math.round(history.encoreRate * 100)}%</p>}
						<ul class="song-history-years">{history.years.map((year) => <li style={`--heat-level: ${Math.round((year.count / heatMax) * 100)}%`}><span>{year.year}</span><strong>{year.count}</strong></li>)}</ul>
						{history.revivals.length > 0 && <div class="song-revivals"><h4>復活演奏</h4><ul>{history.revivals.map((revival) => <li><span class="song-revival-badge">{revival.gapYears}年ぶり</span><DateText value={revival.date} precision="day" />（{revival.gapFrom}以来） {revival.eventHref ? <a href={revival.eventHref}>ライブ詳細</a> : null}</li>)}</ul></div>}
					</div>
				)}
				{journey.length === 0 && history.count === 0 && <p class="empty-state">収録・演奏の記録はありません。</p>}
			</section>
	</article>
</SiteLayout>

<style>
	.song-detail__header {
		max-width: 58rem;
		margin-block-end: var(--space-8);
	}

	.song-detail__description {
		max-width: 48rem;
		white-space: pre-wrap;
	}

	.song-detail__section {
		margin-block: var(--space-8);
	}

	.song-detail__credit-groups {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-6);
	}

	.song-detail__credit-groups ol,
	.placement-list,
	.performance-list {
		margin: 0;
		padding-inline-start: 1.5rem;
	}

	.song-detail__recordings,
	.performance-list {
		display: grid;
		gap: var(--space-4);
	}

	.recording-card,
	.performance-card {
		padding: var(--space-5);
		border: 1px solid var(--rule);
		background: var(--surface);
	}

	.recording-card header h3 {
		margin-block-end: var(--space-1);
	}

	.recording-card__type,
	.placement-list__meta {
		color: var(--ink-muted);
		font-size: 0.9em;
	}

	.recording-card__metadata,
	.performance-card__metadata {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-3) var(--space-5);
		margin-block: var(--space-4);
	}

	.recording-card__metadata dt,
	.performance-card__metadata dt {
		color: var(--ink-muted);
		font-size: 0.85em;
	}

	.recording-card__metadata dd,
	.performance-card__metadata dd {
		margin: 0;
	}

	.placement-list li + li {
		margin-block-start: var(--space-2);
	}

	.placement-list__meta {
		display: block;
	}

	.performance-card__title {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		align-items: baseline;
		font-weight: 700;
	}

	.performance-card__title span {
		color: var(--ink-muted);
		font-size: 0.85em;
		font-weight: 400;
	}

	.empty-state {
		color: var(--ink-muted);
	}

	.song-journey {
		display: grid;
		gap: 0;
		max-width: 54rem;
		margin: 0;
		padding: var(--space-2) 0;
		list-style: none;
		border-block-start: 1px solid var(--rule);
	}

	.song-journey li {
		display: grid;
		grid-template-columns: 1.25rem minmax(0, 1fr);
		gap: var(--space-3);
		min-block-size: 4rem;
		padding-block: var(--space-2);
		border-inline-start: 2px solid var(--accent);
	}

	.song-journey__marker {
		width: 10px;
		height: 10px;
		margin-inline-start: -6px;
		border: 2px solid var(--accent);
		border-radius: 50%;
		background: var(--surface);
	}

	.song-journey__content {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-4);
		align-items: baseline;
	}

	.song-journey small {
		color: var(--ink-muted);
	}

	.song-history-years {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(4rem, 1fr));
		gap: var(--space-2);
		max-width: 54rem;
		margin: var(--space-4) 0;
		padding: 0;
		list-style: none;
		align-items: end;
	}

	.song-history-years li {
		display: grid;
		gap: var(--space-1);
		min-block-size: 5rem;
		padding: var(--space-2);
		align-content: end;
		background: color-mix(in srgb, var(--accent) var(--heat-level), var(--surface));
		border-block-end: 4px solid var(--accent);
	}

	.song-history-years span,
	.song-history-years strong {
		font-variant-numeric: tabular-nums;
	}

	.song-revivals {
		margin-block-start: var(--space-5);
		padding-block-start: var(--space-3);
		border-block-start: 1px solid var(--rule);
	}

	.song-revivals h4 {
		margin-block: 0 var(--space-2);
	}

	.song-revivals ul {
		display: grid;
		gap: var(--space-2);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.song-revival-badge {
		display: inline-block;
		margin-inline-end: var(--space-2);
		padding: 2px var(--space-2);
		border: 1px solid var(--accent);
		color: var(--accent);
		font-size: 12px;
	}

	@media (max-width: 40rem) {
		.song-detail__credit-groups,
		.recording-card__metadata,
		.performance-card__metadata {
			grid-template-columns: 1fr;
		}

		.recording-card,
		.performance-card {
			padding: var(--space-4);
		}
	}
</style>
