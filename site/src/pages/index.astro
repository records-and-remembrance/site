---
import DateText from '../components/DateText.astro';
import EntityLink from '../components/EntityLink.astro';
import { siteData } from '../data';
import { buildHomeModel, type HomeProject } from '../lib/home';
import SiteLayout from '../layouts/SiteLayout.astro';

const home = buildHomeModel(siteData);

// DBのテーブル名ではなく、設計書 §3.1 が定めるサイト上の表記を出す。
const DIG_KIND_LABELS: Record<'composition' | 'event' | 'venue', string> = { composition: '楽曲', event: 'ライブ', venue: '会場' };

const riverPosition = (project: HomeProject): { left: number; width: number } => {
	const range = Math.max(1, home.career.endYear - home.career.startYear);
	const start = project.startYear ?? home.career.startYear;
	const end = Math.max(start, project.endYear);
	const left = Math.max(0, Math.min(100, ((start - home.career.startYear) / range) * 100));
	const width = Math.max(2, Math.min(100 - left, ((end - start) / range) * 100));
	return { left, width };
};
---

<SiteLayout currentPath="/">
	<div class="home-page">
		{home.upcomingEvents.length > 0 && (
			<aside class="home-upcoming" aria-label="予定">
				<div>
					<p class="home-eyebrow">UP NEXT</p>
					<h2>予定</h2>
					<p>これから行われる記録があります。</p>
				</div>
				<ul class="home-upcoming__list">
					{home.upcomingEvents.map((event) => (
						<li>
							<div class="home-upcoming__date"><DateText value={event.date} precision="day" /></div>
							<div>
								<div class="home-upcoming__title">
									{event.href ? <a href={event.href}>{event.label}</a> : <span>{event.label}</span>}
								</div>
								<div class="home-upcoming__meta">
									<EntityLink type="project" slug={event.projectHref ? event.projectHref.split('/').pop() : null} label={event.projectName} />
									<span aria-hidden="true"> · </span>
									<EntityLink type="venue" slug={event.venueHref ? event.venueHref.split('/').pop() : null} label={event.venueName} />
								</div>
							</div>
						</li>
					))}
				</ul>
			</aside>
		)}

		<section class="home-hero" aria-labelledby="page-title">
			<p class="home-eyebrow">PUBLIC ARCHIVE</p>
			<h1 id="page-title">{siteData.title}</h1>
			<p class="home-hero__description">{siteData.description}</p>
			<p class="home-hero__featured">注目プロジェクト: {siteData.featuredProject}</p>
		</section>

		<section class="home-career" aria-labelledby="career-title">
			<div class="home-section-heading">
				<div>
					<p class="home-eyebrow">CAREER RIVER</p>
					<h2 id="career-title">活動の流れ</h2>
				</div>
				<p class="home-section-heading__note">{home.career.startYear} — {home.career.endYear}</p>
			</div>
			<div class="career-river" style={`--river-start-year: ${home.career.startYear}; --river-end-year: ${home.career.endYear};`}>
				<div class="career-river__scale" aria-hidden="true">
					<span class="career-river__scale-track"><span>{home.career.startYear}</span><span>現在</span></span>
				</div>
				<ol class="career-river__list">
					{home.projects.map((project) => {
						const position = riverPosition(project);
						return (
							<li class="career-river__item" data-project-color={project.colorToken} data-project-id={project.id} style={`--project-color: ${project.colorToken}; --river-left: ${position.left}%; --river-width: ${position.width}%;`}>
								{project.href ? (
								<a class="career-river__link" href={project.href}>
										<span class="career-river__label">
											<strong>{project.name}</strong>
											<small>{project.periodLabel}</small>
										</span>
										<span class="career-river__track"><span class="career-river__bar" aria-hidden="true"></span></span>
									</a>
								) : (
									<div class="career-river__link" aria-label={`${project.name}（公開URL未確定）`}>
										<span class="career-river__label">
											<strong>{project.name}</strong>
											<small>{project.periodLabel}</small>
										</span>
										<span class="career-river__track"><span class="career-river__bar" aria-hidden="true"></span></span>
									</div>
								)}
							</li>
						);
					})}
				</ol>
			</div>
		</section>

		<section class="home-counts" aria-labelledby="counts-title">
			<div class="home-section-heading">
				<div>
					<p class="home-eyebrow">AT A GLANCE</p>
					<h2 id="counts-title">記録をたどる</h2>
				</div>
			</div>
			<ul class="home-counts__grid">
				{home.countTiles.map((tile) => (
					<li>
						<a class="home-count-tile" data-count-key={tile.key} href={tile.href}>
							<span>{tile.label}</span>
							<strong class="tabular-nums">{tile.count}</strong>
						</a>
					</li>
				))}
			</ul>
		</section>

		{home.todayEntries.length > 0 && (
			<section id="today-in-history" class="home-today" aria-labelledby="today-title">
				<div class="home-section-heading">
					<div>
						<p class="home-eyebrow">ON THIS DAY</p>
						<h2 id="today-title">この日なんの日</h2>
					</div>
				</div>
				<ul>
					{home.todayEntries.map((entry) => (
						<li>
							<span class="home-today__date"><DateText value={entry.date} precision="day" /></span>
							<a href={entry.href}>{entry.label}</a>
						</li>
					))}
				</ul>
			</section>
		)}

			<section id="dig" class="home-dig" aria-labelledby="dig-title">
				<p class="home-eyebrow">DIG</p>
				<h2 id="dig-title">Dig</h2>
				<p>調べるのとは別の入口から、記録をめぐる。</p>
				{home.dig.length === 0 ? (
					<p>Digは準備中です。</p>
				) : (
					<>
						<div class="home-dig__cards" data-dig-cards>
							{home.dig.map((card) => <article data-dig-card data-dig-type={card.type}><p class="home-dig__kind">{DIG_KIND_LABELS[card.type]}</p><h3><a href={card.href}>{card.label}</a></h3><p>{card.summary}</p></article>)}
						</div>
						<button type="button" data-dig-reroll>もう一度Digする</button>
						<p data-dig-status aria-live="polite"></p>
					</>
				)}
			</section>

			<!-- 閲覧日に該当する記録があるときだけクライアントが開く（設計書 §4.1）。 -->
			<section class="home-anniversary" aria-labelledby="anniversary-title" data-month-day hidden>
				<p class="home-eyebrow">TODAY</p>
				<h2 id="anniversary-title">この日なんの日</h2>
				<p data-month-day-caption></p>
				<ul class="home-anniversary__list" data-month-day-list></ul>
			</section>
	</div>
</SiteLayout>

<style>
	.home-page {
		display: grid;
		gap: var(--space-7);
	}

	.home-eyebrow {
		margin: 0;
		color: var(--accent);
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.14em;
	}

	.home-hero {
		max-width: 58rem;
	}

	.home-hero h1 {
		margin-block: var(--space-2) var(--space-3);
		font-size: clamp(28px, 5vw, 48px);
	}

	.home-hero__description,
	.home-hero__featured {
		margin-block: 0;
	}

	.home-hero__description {
		max-width: 65ch;
		color: var(--ink-muted);
	}

	.home-hero__featured {
		margin-block-start: var(--space-3);
		font-size: 13px;
	}

	.home-upcoming {
		display: grid;
		grid-template-columns: minmax(150px, 0.35fr) 1fr;
		gap: var(--space-4);
		padding: var(--space-4);
		border: 1px solid var(--accent);
		background: color-mix(in srgb, var(--accent) 7%, var(--surface));
	}

	.home-upcoming h2,
	.home-section-heading h2,
	.home-dig h2 {
		margin-block: var(--space-1) 0;
	}

	.home-upcoming p:last-child {
		margin-block: var(--space-2) 0 0;
		color: var(--ink-muted);
		font-size: 13px;
	}

	.home-upcoming__list,
	.home-today ul,
	.career-river__list,
	.home-counts__grid {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.home-upcoming__list {
		display: grid;
		gap: var(--space-3);
	}

	.home-upcoming__list li {
		display: grid;
		grid-template-columns: 8rem 1fr;
		gap: var(--space-3);
		align-items: start;
		padding-block-end: var(--space-3);
		border-block-end: 1px solid var(--rule);
	}

	.home-upcoming__list li:last-child {
		padding-block-end: 0;
		border-block-end: 0;
	}

	.home-upcoming__date,
	.home-today__date,
	.home-section-heading__note,
	.home-count-tile strong {
		font-variant-numeric: tabular-nums;
		font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
	}

	.home-upcoming__date,
	.home-today__date {
		color: var(--ink-muted);
		font-size: 13px;
	}

	.home-upcoming__title {
		font-weight: 700;
	}

	.home-upcoming__meta {
		color: var(--ink-muted);
		font-size: 13px;
	}

	.home-section-heading {
		display: flex;
		justify-content: space-between;
		gap: var(--space-3);
		align-items: end;
		margin-block-end: var(--space-4);
	}

	.home-section-heading__note {
		margin: 0;
		color: var(--ink-muted);
		font-size: 13px;
	}

	.career-river {
		overflow-x: auto;
		padding-block-end: var(--space-2);
	}

	.career-river__scale {
		display: grid;
		grid-template-columns: 22% minmax(32rem, 1fr);
		margin-block-end: var(--space-2);
		color: var(--ink-muted);
		font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
		font-size: 12px;
	}

	.career-river__scale-track {
		display: flex;
		grid-column: 2;
		justify-content: space-between;
	}

	.career-river__list {
		display: grid;
		gap: var(--space-2);
		min-width: 760px;
	}

	.career-river__item {
		position: relative;
		min-block-size: 52px;
		border-block-end: 1px solid var(--rule);
	}

	.career-river__link {
		display: grid;
		grid-template-columns: 22% minmax(32rem, 1fr);
		align-items: center;
		min-block-size: 52px;
		color: var(--ink);
		text-decoration: none;
	}

	.career-river__link:hover .career-river__label strong {
		color: var(--accent);
	}

	.career-river__bar {
		position: absolute;
		inset-block: 8px;
		left: var(--river-left);
		width: var(--river-width);
		border-radius: 2px;
		background: var(--project-color);
		opacity: 0.82;
	}

	.career-river__track {
		position: relative;
		min-block-size: 36px;
		border-block: 1px solid var(--rule);
	}

	.career-river__label {
		display: grid;
		gap: 2px;
		padding-inline-end: var(--space-3);
	}

	.career-river__label small {
		color: var(--ink-muted);
		font-size: 12px;
	}

	.home-counts__grid {
		display: grid;
		grid-template-columns: repeat(6, minmax(0, 1fr));
		gap: var(--space-2);
	}

	.home-count-tile {
		display: grid;
		gap: var(--space-2);
		min-block-size: 124px;
		padding: var(--space-3);
		border: 1px solid var(--rule);
		background: var(--surface);
		color: var(--ink);
		text-decoration: none;
	}

	.home-count-tile:hover {
		border-color: var(--accent);
	}

	.home-count-tile span {
		color: var(--ink-muted);
		font-size: 13px;
	}

	.home-count-tile strong {
		align-self: end;
		font-size: clamp(26px, 4vw, 38px);
		font-weight: 500;
		line-height: 1;
	}

	.home-today {
		padding-block-start: var(--space-5);
		border-block-start: 1px solid var(--rule);
	}

	.home-today ul {
		display: grid;
		gap: var(--space-2);
	}

	.home-today li {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-3);
		align-items: baseline;
	}

		.home-dig {
		padding: var(--space-5);
		border: 1px dashed var(--rule);
		background: var(--surface);
	}

	.home-dig p:last-child {
		margin-block: var(--space-2) 0;
		color: var(--ink-muted);
	}

	@media (max-width: 1024px) {
		.home-counts__grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (max-width: 640px) {
		.home-page {
			gap: var(--space-6);
		}

		.home-upcoming {
			grid-template-columns: 1fr;
		}

		.home-upcoming__list li {
			grid-template-columns: 1fr;
			gap: var(--space-1);
		}

		.career-river__scale {
			display: block;
			min-width: 0;
		}

		.career-river__scale-track {
			grid-column: auto;
		}

		.career-river__item {
			min-block-size: 64px;
		}

		.career-river__link {
			grid-template-columns: 1fr;
			min-block-size: 64px;
			padding-block: var(--space-2);
		}

		.career-river__bar {
			inset: auto 0 0;
			width: 100%;
			height: 8px;
		}

		.career-river__track {
			min-block-size: 16px;
			border-block: 0;
		}

		.career-river__label {
			grid-column: 1;
		}

		.home-counts__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		}

		.home-dig__cards {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: var(--space-3);
		}

		.home-dig__cards article {
			display: grid;
			gap: var(--space-1);
			align-content: start;
			padding: var(--space-3);
			border: 1px solid var(--rule);
			background: var(--surface);
		}

		.home-dig__cards h3 {
			margin: 0;
			font-size: 1.05rem;
		}

		.home-dig__kind {
			color: var(--ink-muted);
			font-size: 12px;
			letter-spacing: 0.06em;
		}

		.home-dig__cards article > p:last-child {
			color: var(--ink-muted);
			font-size: 0.9rem;
			font-variant-numeric: tabular-nums;
		}

		.home-anniversary__list {
			display: grid;
			gap: var(--space-2);
			margin: var(--space-4) 0 0;
			padding: 0;
			list-style: none;
		}

		.home-anniversary__list li {
			display: grid;
			grid-template-columns: 5rem 4rem minmax(0, 1fr);
			gap: var(--space-3);
			align-items: baseline;
			padding-block: var(--space-2);
			border-block-end: 1px solid var(--rule);
		}

		.home-anniversary__year {
			font-variant-numeric: tabular-nums;
		}

		.home-anniversary__year,
		.home-anniversary__kind {
			color: var(--ink-muted);
			font-size: 0.9rem;
		}

		@media (max-width: 640px) {
			.home-dig__cards {
				grid-template-columns: 1fr;
			}

			.home-anniversary__list li {
				grid-template-columns: 5rem 1fr;
			}

			.home-anniversary__list li > a {
				grid-column: 1 / -1;
			}
		}
	</style>

	<script define:vars={{ candidates: home.digCandidates }}>
		const reroll = document.querySelector('[data-dig-reroll]');
		const status = document.querySelector('[data-dig-status]');
		reroll?.addEventListener('click', () => {
			for (const card of document.querySelectorAll('[data-dig-card]')) {
				const list = candidates[card.dataset.digType] ?? [];
				const next = list[Math.floor(Math.random() * list.length)];
				if (!next) continue;
				const link = card.querySelector('a');
				const summary = card.querySelector('p:last-child');
				if (link) { link.href = next.href; link.textContent = next.label; }
				if (summary) summary.textContent = next.summary;
			}
			if (status) status.textContent = 'Digの候補を更新しました。';
		});
	</script>

	<script>
		import { isoDateOf, MONTH_DAY_KIND_LABELS, monthDayKey, selectAnniversaryEntries } from '../lib/month-day';

		// 閲覧日の月日に一致する過去の記録を、静的JSONから引いて描画する。
		(async () => {
			const section = document.querySelector('[data-month-day]');
			if (!(section instanceof HTMLElement)) return;

			const today = new Date();
			let index: Record<string, { type: 'event' | 'release'; date: string; label: string; href: string }[]>;
			try {
				const response = await fetch('/month-day.json');
				if (!response.ok) return;
				index = await response.json();
			} catch {
				return;
			}

			const entries = selectAnniversaryEntries(index[monthDayKey(today)], isoDateOf(today));
			if (entries.length === 0) return;

			const list = section.querySelector('[data-month-day-list]');
			const caption = section.querySelector('[data-month-day-caption]');
			if (caption) caption.textContent = `${today.getMonth() + 1}月${today.getDate()}日の記録が${entries.length}件あります。`;
			for (const entry of entries) {
				const item = document.createElement('li');
				const year = document.createElement('span');
				year.className = 'home-anniversary__year';
				year.textContent = `${entry.date.slice(0, 4)}年`;
				const kind = document.createElement('span');
				kind.className = 'home-anniversary__kind';
				kind.textContent = MONTH_DAY_KIND_LABELS[entry.type] ?? entry.type;
				const link = document.createElement('a');
				link.href = entry.href;
				link.textContent = entry.label;
				item.append(year, kind, link);
				list?.append(item);
			}
			section.hidden = false;
		})();
	</script>
