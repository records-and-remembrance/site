---
import SiteLayout from '../../layouts/SiteLayout.astro';
import DateText from '../../components/DateText.astro';
import { siteData, siteTableRows } from '../../data';
import { buildPersonPageModel, type SiteRow } from '../../lib/people';
import { buildEntityHref } from '../../lib/site-foundation';
import { buildTimelinePosition } from '../../lib/timeline-position';

export function getStaticPaths() {
	const people = siteTableRows('person');
	return people.flatMap((person) => {
		const slug = typeof person.slug === 'string' ? person.slug : '';
		return buildEntityHref('person', slug) ? [{ params: { slug }, props: { person } }] : [];
	});
}

const people = siteTableRows('person');
const { person: personProp } = Astro.props as { person?: SiteRow };
const selectedPerson = personProp ?? people.find((person) => person.slug === Astro.params.slug);
const model = selectedPerson
	? buildPersonPageModel({
		person: selectedPerson,
		people,
		projects: siteTableRows('project'),
		memberships: siteTableRows('membership'),
		membershipRoles: siteTableRows('membershipRole'),
		roles: siteTableRows('role'),
		instruments: siteTableRows('instrument'),
		compositions: siteTableRows('composition'),
		compositionCredits: siteTableRows('compositionCredit'),
		releases: siteTableRows('release'),
		works: siteTableRows('work'),
		recordings: siteTableRows('recording'),
		events: siteTableRows('event'),
		contributions: siteTableRows('contribution'),
	})
	: undefined;
const slug = Astro.params.slug ?? '';
const membershipDates = model?.memberships.flatMap((membership) => [membership.fromDate, membership.toDate]).filter((value): value is string => Boolean(value)) ?? [];
const timelineStart = model?.activityPeriod.from ?? membershipDates.sort()[0] ?? siteData.snapshotGeneratedAt.slice(0, 10);
const timelineEnd = model?.activityPeriod.to ?? (siteData.snapshotGeneratedAt.slice(0, 10) || membershipDates.at(-1) || timelineStart);
---

<SiteLayout
	title={model?.name ?? '人物'}
	currentPath={`/people/${slug}`}
	breadcrumbs={[{ label: '人物', href: '/people' }, { label: model?.name ?? '人物' }]}
>
	{model ? (
		<article aria-labelledby="person-title">
			<header>
				<h1 id="person-title">{model.name}</h1>
				{model.description && <p>{model.description}</p>}
				{(model.activityPeriod.from || model.activityPeriod.to) && (
					<p>
						活動期間:{' '}
						{model.activityPeriod.from && <DateText value={model.activityPeriod.from} precision={model.activityPeriod.fromPrecision} />}
						{model.activityPeriod.from && model.activityPeriod.to && ' – '}
						{model.activityPeriod.to && <DateText value={model.activityPeriod.to} precision={model.activityPeriod.toPrecision} />}
						{(model.activityPeriod.fromDerived || model.activityPeriod.toDerived) && <small>（記録から導出）</small>}
					</p>
				)}
			</header>

			{model.roleSummary.length > 0 && (
				<section aria-labelledby="role-summary-title" class="person-role-summary">
					<h2 id="role-summary-title">役割の集計</h2>
					<ul>{model.roleSummary.map((role) => <li><span>{role.label}</span><strong>{role.count}</strong></li>)}</ul>
				</section>
			)}

			{model.memberships.length > 0 && (
				<section aria-labelledby="memberships-title">
					<h2 id="memberships-title">在籍・参加</h2>
					<div class="person-timeline" style={`--person-timeline-start: ${timelineStart.slice(0, 4)}; --person-timeline-end: ${timelineEnd.slice(0, 4)};`}>
						<div class="person-timeline__axis"><span>{timelineStart.slice(0, 4)}</span><span>現在</span></div>
						<ol>
							{model.memberships.map((membership) => {
								const position = buildTimelinePosition(membership.fromDate, timelineStart, timelineEnd, membership.toDate);
								return <li style={`--project-color: ${membership.projectColor}; --timeline-left: ${position.left}%; --timeline-width: ${position.width}%;`}>
									<span class="person-timeline__label">{membership.projectHref ? <a href={membership.projectHref}>{membership.projectName}</a> : membership.projectName}</span>
									<span class="person-timeline__track"><span class={membership.support ? 'person-timeline__bar person-timeline__bar--support' : 'person-timeline__bar'}></span></span>
								</li>;
							})}
						</ol>
					</div>
					<ol>
						{model.memberships.map((membership) => (
							<li>
								<h3>
									{membership.projectHref ? <a href={membership.projectHref}>{membership.projectName}</a> : <span>{membership.projectName}</span>}
									{membership.support && <small>（サポート）</small>}
								</h3>
								<p>
									在籍期間:{' '}
									{membership.fromDate && <DateText value={membership.fromDate} precision={membership.fromDatePrecision} />}
									{membership.fromDate && membership.toDate && ' – '}
									{membership.toDate ? <DateText value={membership.toDate} precision={membership.toDatePrecision} /> : <span>現在</span>}
								</p>
								{membership.roles.length > 0 && (
									<p>
										役割: {membership.roles.join('、')}
									</p>
								)}
							</li>
						))}
					</ol>
				</section>
			)}

			{model.credits.length > 0 && (
				<section aria-labelledby="credits-title">
					<h2 id="credits-title">作曲・作詞クレジット</h2>
					<ul>
						{model.credits.map((credit) => (
							<li>
								{credit.typeLabel}: {credit.href ? <a href={credit.href}>{credit.label}</a> : <span>{credit.label}</span>}
							</li>
						))}
					</ul>
				</section>
			)}

			{(model.contributions.releases.length > 0 || model.contributions.events.length > 0 || model.contributions.recordings.length > 0) && (
				<section aria-labelledby="contributions-title">
					<h2 id="contributions-title">関与</h2>
					{model.contributions.releases.length > 0 && (
						<div>
							<h3>リリース参加</h3>
							<ul>
								{model.contributions.releases.map((contribution) => (
									<li>
										{contribution.href ? <a href={contribution.href}>{contribution.label}</a> : <span>{contribution.label}</span>}
										{contribution.date && <DateText value={contribution.date} precision="day" />}
										{(contribution.roleLabel || contribution.instrumentLabel) && <small>（{[contribution.roleLabel, contribution.instrumentLabel].filter(Boolean).join(' / ')}）</small>}
									</li>
								))}
							</ul>
						</div>
					)}
					{model.contributions.events.length > 0 && (
						<div>
							<h3>ライブ参加</h3>
							<ul>
								{model.contributions.events.map((contribution) => (
									<li>
										{contribution.href ? <a href={contribution.href}>{contribution.label}</a> : <span>{contribution.label}</span>}
										{contribution.date && <DateText value={contribution.date} precision="day" />}
										{(contribution.roleLabel || contribution.instrumentLabel) && <small>（{[contribution.roleLabel, contribution.instrumentLabel].filter(Boolean).join(' / ')}）</small>}
									</li>
								))}
							</ul>
						</div>
					)}
					{model.contributions.recordings.length > 0 && (
						<div>
							<h3>録音参加</h3>
							<ul>
								{model.contributions.recordings.map((contribution) => (
									<li>
										{contribution.href ? <a href={contribution.href}>{contribution.label}</a> : <span>{contribution.label}</span>}
										{contribution.date && <DateText value={contribution.date} precision="day" />}
										{(contribution.roleLabel || contribution.instrumentLabel) && <small>（{[contribution.roleLabel, contribution.instrumentLabel].filter(Boolean).join(' / ')}）</small>}
									</li>
								))}
							</ul>
						</div>
					)}
				</section>
			)}

			{model.coPerformers.length > 0 && (
				<section aria-labelledby="co-performers-title">
					<h2 id="co-performers-title">共演・共活動</h2>
					<ul>
						{model.coPerformers.map((coPerformer) => (
							<li>
								{coPerformer.href ? <a href={coPerformer.href}>{coPerformer.name}</a> : <span>{coPerformer.name}</span>}
								<small>（根拠: {coPerformer.reasons.join('、')}）</small>
							</li>
						))}
					</ul>
				</section>
			)}
		</article>
	) : (
		<p>人物が見つかりません。</p>
	)}
</SiteLayout>

<style>
	article[aria-labelledby='person-title'] {
		display: grid;
		gap: var(--space-6);
	}

	article[aria-labelledby='person-title'] > header {
		max-width: var(--reading-width);
	}

	.person-role-summary ul {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.person-role-summary li {
		display: inline-flex;
		gap: var(--space-2);
		align-items: baseline;
		padding: var(--space-2) var(--space-3);
		border: 1px solid var(--rule);
		background: var(--surface);
	}

	.person-role-summary strong {
		font-variant-numeric: tabular-nums;
	}

	.person-timeline {
		overflow-x: auto;
		padding-block: var(--space-2);
	}

	.person-timeline__axis,
	.person-timeline li {
		display: grid;
		grid-template-columns: 11rem minmax(30rem, 1fr);
		gap: var(--space-3);
		align-items: center;
	}

	.person-timeline__axis {
		margin-inline-start: 11rem;
		grid-template-columns: minmax(30rem, 1fr);
		color: var(--ink-muted);
		font-size: 12px;
	}

	.person-timeline__axis > span:last-child {
		justify-self: end;
	}

	.person-timeline ol {
		display: grid;
		gap: var(--space-2);
		min-width: 46rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.person-timeline li {
		padding-block: var(--space-2);
		border-block-end: 1px solid var(--rule);
	}

	.person-timeline__track {
		position: relative;
		block-size: 12px;
		border-block-end: 1px solid var(--rule);
	}

	.person-timeline__bar {
		position: absolute;
		inset-block-start: 2px;
		left: var(--timeline-left);
		width: var(--timeline-width);
		block-size: 8px;
		background: var(--project-color);
	}

	.person-timeline__bar--support {
		background: transparent;
		border: 2px dashed var(--project-color);
	}

	@media (max-width: 640px) {
		.person-timeline__axis,
		.person-timeline li {
			grid-template-columns: 8rem minmax(22rem, 1fr);
		}

		.person-timeline__axis {
			margin-inline-start: 8rem;
		}
	}
</style>
