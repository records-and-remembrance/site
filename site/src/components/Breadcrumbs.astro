---
export type Breadcrumb = {
	label: string;
	href?: string;
};

interface Props {
	items?: readonly Breadcrumb[];
}

const { items = [] } = Astro.props;
---

{items.length > 0 && (
	<nav class="breadcrumbs" aria-label="パンくず">
		<ol class="breadcrumbs__list">
			{items.map((item, index) => (
				<li class="breadcrumbs__item">
					{item.href && index < items.length - 1 ? <a href={item.href}>{item.label}</a> : <span class="breadcrumbs__current" aria-current="page">{item.label}</span>}
				</li>
			))}
		</ol>
	</nav>
)}
