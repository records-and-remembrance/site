prefix_rule(
    pattern = ["docker", "compose", "exec", "-T", "postgres", "psql"],
    decision = "allow",
    justification = "Allow project-local PostgreSQL access through Docker Compose.",
    match = [
        "docker compose exec -T postgres psql",
        "docker compose exec -T postgres psql --version",
        "docker compose exec -T postgres psql -U postgres",
    ],
    not_match = [
        "docker compose exec postgres psql",
        "docker compose exec -T postgres bash",
    ],
)
