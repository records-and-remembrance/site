{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$(git rev-parse --show-toplevel)/.codex/hooks/git-diff-commit-recommendation.js\"",
            "timeout": 10,
            "statusMessage": "Git差分の行数を確認しています"
          }
        ]
      }
    ]
  }
}
