{
  "scripts": {
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "if [ -z \"$DRIZZLE_DATABASE_URL\" ]; then echo \"Set DRIZZLE_DATABASE_URL to a fresh Drizzle-managed database before migrating\"; exit 1; fi; DATABASE_URL=\"$DRIZZLE_DATABASE_URL\" drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:generate:band-releases": "bun scripts/generate_band_release_seed_sql.ts",
    "db:generate:labels": "bun scripts/generate_label_seed_sql.ts",
    "review:compositions": "bun run app/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.25",
    "pg": "^8.22.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3"
  }
}
